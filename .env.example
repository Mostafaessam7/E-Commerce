# Copy this file to `.env` (gitignored — never commit the real one) before running
# `docker compose up`. See docs/deployment.md.

# SQL Server's SA password inside the compose stack. This is a real credential — even though the
# container is local/ephemeral, docker-compose.yml requires it via ${SQL_SA_PASSWORD:?...} rather
# than hardcoding a default, same discipline as every other real credential in this repo (see
# docs/security.md). Must satisfy SQL Server's complexity policy (8+ chars, upper+lower+digit or
# symbol).
SQL_SA_PASSWORD=Change_Me_123!
