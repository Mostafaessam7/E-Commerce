<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CA1711: IIntegrationEventHandler intentionally mirrors the well-known
         "I{X}EventHandler" naming used across the .NET eventing ecosystem (e.g. MediatR's
         INotificationHandler); it is not a delegate type, so the naming-rule's concern doesn't apply. -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
