  <!-- Returns -->
  <data name="Policy" xml:space="preserve"><value>السياسة</value></data>
  <data name="30-day returns" xml:space="preserve"><value>الإرجاع خلال 30 يومًا</value></data>
  <data name="If something isn't right, you can return it within 30 days of delivery for a full refund to your original payment method. Items should be unworn, unwashed, and in their original packaging with tags attached." xml:space="preserve"><value>إذا لم يكن المنتج مناسبًا، يمكنك إرجاعه خلال 30 يومًا من التسليم واسترداد كامل المبلغ إلى وسيلة الدفع الأصلية. يجب أن تكون القطع غير مرتداة وغير مغسولة وفي عبوتها الأصلية مع بقاء البطاقات.</value></data>
  <data name="How to start a return" xml:space="preserve"><value>كيفية بدء عملية إرجاع</value></data>
  <data name="Contact us at" xml:space="preserve"><value>تواصل معنا على</value></data>
  <data name="with your order number (find it on your" xml:space="preserve"><value>مع رقم طلبك (تجده في صفحة</value></data>
  <data name="page) and which item you'd like to return. We'll reply with return instructions." xml:space="preserve"><value>) والمنتج الذي ترغب في إرجاعه. سنرد عليك بتعليمات الإرجاع.</value></data>
  <data name="Exchanges" xml:space="preserve"><value>الاستبدال</value></data>
  <data name="Need a different size or color? Return the original item for a refund and place a new order for the item you want — that way you're not waiting on us to receive the return before your replacement ships." xml:space="preserve"><value>تحتاج مقاسًا أو لونًا مختلفًا؟ أرجع القطعة الأصلية لاسترداد المبلغ وقدّم طلبًا جديدًا للقطعة التي تريدها — بهذه الطريقة لن تنتظر استلامنا للمرتجع قبل شحن البديل.</value></data>
  <data name="Damaged or incorrect items" xml:space="preserve"><value>المنتجات التالفة أو الخاطئة</value></data>
  <data name="If an item arrives damaged or isn't what you ordered, contact us right away and we'll make it right at no cost to you." xml:space="preserve"><value>إذا وصل منتج تالفًا أو غير مطابق لطلبك، تواصل معنا فورًا وسنقوم بتصحيح الأمر دون أي تكلفة عليك.</value></data>

  <!-- Terms & Conditions -->
  <data name="Last updated:" xml:space="preserve"><value>آخر تحديث:</value></data>
  <data name="Using this site" xml:space="preserve"><value>استخدام هذا الموقع</value></data>
  <data name="By placing an order with us, you confirm the information you provide (contact details, shipping address, payment information) is accurate and that you're authorized to use the payment method on the order." xml:space="preserve"><value>عند تقديم طلب معنا، فإنك تؤكد أن المعلومات التي تقدمها (بيانات التواصل، عنوان الشحن، معلومات الدفع) دقيقة وأنك مخوّل باستخدام وسيلة الدفع في الطلب.</value></data>
  <data name="Pricing and availability" xml:space="preserve"><value>الأسعار والتوفر</value></data>
  <data name="Prices are shown in the currency displayed at checkout and can change without notice. Placing an item in your cart doesn't reserve it — stock is confirmed at checkout, and an item can occasionally sell out between adding it to your cart and completing your order." xml:space="preserve"><value>تُعرض الأسعار بالعملة الظاهرة عند الدفع ويمكن أن تتغير دون إشعار مسبق. إضافة منتج إلى سلتك لا يحجزه — يتم تأكيد التوفر عند الدفع، وقد ينفد المنتج أحيانًا بين إضافته إلى السلة وإتمام الطلب.</value></data>
  <data name="Orders and payment" xml:space="preserve"><value>الطلبات والدفع</value></data>
  <data name="An order is confirmed once payment is successfully processed. We reserve the right to cancel an order — with a full refund — if we're unable to fulfill it." xml:space="preserve"><value>يتم تأكيد الطلب بمجرد معالجة الدفع بنجاح. نحتفظ بالحق في إلغاء أي طلب — مع استرداد كامل المبلغ — إذا تعذّر علينا تنفيذه.</value></data>
  <data name="Returns" xml:space="preserve"><value>الإرجاع</value></data>
  <data name="page for the full return policy." xml:space="preserve"><value>للاطلاع على سياسة الإرجاع كاملة.</value></data>
  <data name="Questions about these terms can be sent to" xml:space="preserve"><value>يمكن إرسال الأسئلة حول هذه الشروط إلى</value></data>

