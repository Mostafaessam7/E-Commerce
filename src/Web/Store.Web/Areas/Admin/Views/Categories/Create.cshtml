@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@model CreateCategoryFormModel
@{
    ViewData["Title"] = "New Category";
}

<div class="wg-box" style="max-width:560px">
    <form asp-action="Create" method="post" class="form-style-1">
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-error"></div>

        <fieldset class="name">
            <div class="body-title">@Localizer["Name"] <span class="tf-color-1">*</span></div>
            <input asp-for="Name" class="flex-grow" type="text" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </fieldset>

        <fieldset class="name">
            <div class="body-title">@Localizer["Slug"] <span class="tf-color-1">*</span></div>
            <input asp-for="Slug" class="flex-grow" type="text" placeholder="e.g. mens-shoes" />
            <span asp-validation-for="Slug" class="text-danger"></span>
        </fieldset>

        <fieldset class="category">
            <div class="body-title">@Localizer["Parent Category (optional)"]</div>
            <div class="select flex-grow">
                <select asp-for="ParentId">
                    <option value="">@Localizer["— Top level —"]</option>
                    @foreach (var category in (IReadOnlyList<CategoryDto>)ViewBag.Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
        </fieldset>

        <div class="bot">
            <a asp-action="Index" class="tf-button style-2 w208">@Localizer["Cancel"]</a>
            <button class="tf-button w208" type="submit">@Localizer["Create Category"]</button>
        </div>
    </form>
</div>
