@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "Categories";
    var byId = Model.ToDictionary(c => c.Id);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Categories</h1>
    <a asp-action="Create" class="btn btn-dark">New Category</a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Parent</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.Name</td>
            <td><code>@category.Slug</code></td>
            <td>@(category.ParentId is Guid parentId && byId.TryGetValue(parentId, out var parent) ? parent.Name : "—")</td>
            <td><span class="admin-badge">@(category.IsActive ? "Active" : "Inactive")</span></td>
            <td>
                @if (category.IsActive)
                {
                    <form asp-action="Deactivate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@category.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm">Deactivate</button>
                    </form>
                }
                else
                {
                    <form asp-action="Activate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@category.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Activate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="mt-3">No categories yet.</p>
}
