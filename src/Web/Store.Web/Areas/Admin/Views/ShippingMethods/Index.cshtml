@model IReadOnlyList<ShippingMethodDto>
@{
    ViewData["Title"] = "Shipping Methods";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Shipping Methods</h1>
    <a asp-action="Create" class="btn btn-dark">New Shipping Method</a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Cost</th>
            <th>Estimate</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var method in Model)
    {
        <tr>
            <td>
                @method.Name
                @if (!string.IsNullOrWhiteSpace(method.Description))
                {
                    <div class="text-muted small">@method.Description</div>
                }
            </td>
            <td>@method.Cost.ToString("0.00") @method.Currency</td>
            <td>@(method.EstimatedDaysMin is not null ? $"{method.EstimatedDaysMin}-{method.EstimatedDaysMax} days" : "—")</td>
            <td><span class="admin-badge">@(method.IsActive ? "Active" : "Inactive")</span></td>
            <td>
                @if (method.IsActive)
                {
                    <form asp-action="Deactivate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@method.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm">Deactivate</button>
                    </form>
                }
                else
                {
                    <form asp-action="Activate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@method.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Activate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="mt-3">No shipping methods yet.</p>
}
