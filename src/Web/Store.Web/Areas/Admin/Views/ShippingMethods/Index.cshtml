@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@model IReadOnlyList<ShippingMethodDto>
@{
    ViewData["Title"] = "Shipping Methods";
}

<div class="wg-box">
    <div class="flex items-center justify-between gap10 flex-wrap mb-20">
        <div class="body-text">@Model.Count @Localizer["shipping method(s) total."]</div>
        <a asp-action="Create" class="tf-button style-1 w208"><i class="icon-plus"></i>@Localizer["New Shipping Method"]</a>
    </div>

    <div class="wg-table table-all-category">
        <ul class="table-title flex gap20 mb-14">
            <li><div class="body-title">@Localizer["Name"]</div></li>
            <li><div class="body-title">@Localizer["Cost"]</div></li>
            <li><div class="body-title">@Localizer["Estimate"]</div></li>
            <li><div class="body-title">@Localizer["Status"]</div></li>
            <li><div class="body-title">@Localizer["Action"]</div></li>
        </ul>
        <ul class="flex flex-column">
        @foreach (var method in Model)
        {
            <li class="wg-product item-row gap20">
                <div class="body-text text-main-dark mt-4">
                    @method.Name
                    @if (!string.IsNullOrWhiteSpace(method.Description))
                    {
                        <div class="text-tiny">@method.Description</div>
                    }
                </div>
                <div class="body-text text-main-dark mt-4">@method.Cost.ToString("0.00") @method.Currency</div>
                <div class="body-text text-main-dark mt-4">@(method.EstimatedDaysMin is not null ? $"{method.EstimatedDaysMin}-{method.EstimatedDaysMax} " + Localizer["days"] : "—")</div>
                <div class="mt-4">
                    <div class="@(method.IsActive ? "block-available" : "block-stock") bg-1 fw-7">@(method.IsActive ? Localizer["Active"] : Localizer["Inactive"])</div>
                </div>
                <div class="list-icon-function">
                    @if (method.IsActive)
                    {
                        <form asp-action="Deactivate" method="post">
                            <input type="hidden" name="id" value="@method.Id" />
                            <button type="submit" class="item edit" title="@Localizer["Deactivate"]"><i class="icon-slash"></i></button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" method="post">
                            <input type="hidden" name="id" value="@method.Id" />
                            <button type="submit" class="item eye" title="@Localizer["Activate"]"><i class="icon-check"></i></button>
                        </form>
                    }
                </div>
            </li>
        }
        </ul>
    </div>

    @if (Model.Count == 0)
    {
        <p class="mt-14">@Localizer["No shipping methods yet."]</p>
    }
</div>
