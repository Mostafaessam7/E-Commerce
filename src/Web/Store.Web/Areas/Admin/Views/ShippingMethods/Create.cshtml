@model CreateShippingMethodFormModel
@{
    ViewData["Title"] = "New Shipping Method";
}

<h1>New Shipping Method</h1>

<form asp-action="Create" method="post" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input asp-for="Name" class="form-control" placeholder="e.g. Standard" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Description (optional)</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cost</label>
        <input asp-for="Cost" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Cost" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Currency</label>
        <input asp-for="Currency" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Estimated Days Min (optional)</label>
        <input asp-for="EstimatedDaysMin" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Estimated Days Max (optional)</label>
        <input asp-for="EstimatedDaysMax" type="number" class="form-control" />
    </div>

    <button type="submit" class="btn btn-dark">Create Shipping Method</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
