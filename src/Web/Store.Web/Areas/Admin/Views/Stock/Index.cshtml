@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@model StockSearchResultDto
@{
    ViewData["Title"] = "Stock";
}

<div class="wg-box">
    <div class="body-text mb-20">@Model.TotalCount @Localizer["stock item(s) tracked."]</div>

    <div class="wg-table table-all-category">
        <ul class="table-title flex gap20 mb-14">
            <li><div class="body-title">@Localizer["Product"]</div></li>
            <li><div class="body-title">@Localizer["On Hand"]</div></li>
            <li><div class="body-title">@Localizer["Reserved"]</div></li>
            <li><div class="body-title">@Localizer["Available"]</div></li>
            <li><div class="body-title">@Localizer["Low Stock Threshold"]</div></li>
            <li><div class="body-title">@Localizer["Adjust"]</div></li>
        </ul>
        <ul class="flex flex-column">
        @foreach (var item in Model.Items)
        {
            <li class="wg-product item-row gap20">
                <div class="mt-4">
                    @if (item.ProductName is not null)
                    {
                        <div class="body-text text-main-dark fw-6">@item.ProductName</div>
                        <div class="text-muted fs-14">@item.Sku</div>
                    }
                    else
                    {
                        <div class="body-text text-main-dark"><code>@item.ProductVariantId</code></div>
                        <div class="text-muted fs-14">@Localizer["Product not found in Catalog"]</div>
                    }
                </div>
                <div class="body-text text-main-dark mt-4">@item.QuantityOnHand</div>
                <div class="body-text text-main-dark mt-4">@item.QuantityReserved</div>
                <div class="mt-4">
                    <span class="body-text text-main-dark">@item.AvailableQuantity</span>
                    @if (item.IsOutOfStock)
                    {
                        <div class="block-not-available bg-1 fw-7 mt-4">@Localizer["Out of stock"]</div>
                    }
                </div>
                <div class="body-text text-main-dark mt-4">@item.LowStockThreshold</div>
                <form asp-action="Adjust" method="post" class="flex gap10">
                    <input type="hidden" name="ProductVariantId" value="@item.ProductVariantId" />
                    <input type="number" name="NewQuantityOnHand" style="width:90px" value="@item.QuantityOnHand" required />
                    <input type="text" name="Reason" placeholder="@Localizer["Reason"]" required />
                    <button type="submit" class="tf-button style-2 w128">@Localizer["Adjust"]</button>
                </form>
            </li>
        }
        </ul>
    </div>

    @if (Model.TotalCount == 0)
    {
        <p class="mt-14">@Localizer["No stock is tracked yet."]</p>
    }

    @{
        var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    }
    @if (totalPages > 1)
    {
        <ul class="wg-pagination mt-20">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="@(p == Model.Page ? "active" : "")"><a asp-action="Index" asp-route-page="@p">@p</a></li>
            }
        </ul>
    }
</div>
