@model StockSearchResultDto
@{
    ViewData["Title"] = "Stock";
}

<div class="wg-box">
    <div class="body-text mb-20">@Model.TotalCount stock item(s) tracked.</div>

    <div class="wg-table table-all-category">
        <ul class="table-title flex gap20 mb-14">
            <li><div class="body-title">Product Variant Id</div></li>
            <li><div class="body-title">On Hand</div></li>
            <li><div class="body-title">Reserved</div></li>
            <li><div class="body-title">Available</div></li>
            <li><div class="body-title">Low Stock Threshold</div></li>
            <li><div class="body-title">Adjust</div></li>
        </ul>
        <ul class="flex flex-column">
        @foreach (var item in Model.Items)
        {
            <li class="item-row gap20">
                <div class="body-text text-main-dark mt-4"><code>@item.ProductVariantId</code></div>
                <div class="body-text text-main-dark mt-4">@item.QuantityOnHand</div>
                <div class="body-text text-main-dark mt-4">@item.QuantityReserved</div>
                <div class="body-text text-main-dark mt-4">@item.AvailableQuantity @(item.IsOutOfStock ? "(out of stock)" : "")</div>
                <div class="body-text text-main-dark mt-4">@item.LowStockThreshold</div>
                <form asp-action="Adjust" method="post" class="flex gap10">
                    <input type="hidden" name="ProductVariantId" value="@item.ProductVariantId" />
                    <input type="number" name="NewQuantityOnHand" style="width:90px" value="@item.QuantityOnHand" required />
                    <input type="text" name="Reason" placeholder="Reason" required />
                    <button type="submit" class="tf-button style-2 w100">Adjust</button>
                </form>
            </li>
        }
        </ul>
    </div>

    @if (Model.TotalCount == 0)
    {
        <p class="mt-14">No stock is tracked yet.</p>
    }

    @{
        var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    }
    @if (totalPages > 1)
    {
        <ul class="wg-pagination mt-20">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="@(p == Model.Page ? "active" : "")"><a asp-action="Index" asp-route-page="@p">@p</a></li>
            }
        </ul>
    }
</div>
