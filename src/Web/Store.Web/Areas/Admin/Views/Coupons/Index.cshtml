@model IReadOnlyList<CouponDto>
@{
    ViewData["Title"] = "Coupons";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Coupons</h1>
    <a asp-action="Create" class="btn btn-dark">New Coupon</a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Discount</th>
            <th>Status</th>
            <th>Usage</th>
            <th>Expires</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var coupon in Model)
    {
        <tr>
            <td><code>@coupon.Code</code></td>
            <td>@(coupon.DiscountType == "Percentage" ? $"{coupon.Value}%" : $"{coupon.Value:0.00} {coupon.Currency}")</td>
            <td><span class="admin-badge">@(coupon.IsActive ? "Active" : "Inactive")</span></td>
            <td>@coupon.UsageCount@(coupon.UsageLimit is int limit ? $" / {limit}" : "")</td>
            <td>@(coupon.ExpiresAtUtc?.ToString("yyyy-MM-dd") ?? "—")</td>
            <td>
                @if (coupon.IsActive)
                {
                    <form asp-action="Deactivate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@coupon.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm">Deactivate</button>
                    </form>
                }
                else
                {
                    <form asp-action="Activate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@coupon.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Activate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="mt-3">No coupons yet.</p>
}
