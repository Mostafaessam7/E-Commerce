@model CreateCouponFormModel
@{
    ViewData["Title"] = "New Coupon";
}

<div class="wg-box" style="max-width:560px">
    <form asp-action="Create" method="post" class="form-style-1">
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-error"></div>

        <fieldset class="name">
            <div class="body-title">Code <span class="tf-color-1">*</span></div>
            <input asp-for="Code" class="flex-grow" type="text" placeholder="e.g. SAVE10" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </fieldset>

        <fieldset class="category">
            <div class="body-title">Discount Type</div>
            <div class="select flex-grow">
                <select asp-for="DiscountType">
                    <option value="Percentage">Percentage</option>
                    <option value="FixedAmount">Fixed Amount</option>
                </select>
            </div>
        </fieldset>

        <fieldset class="name">
            <div class="body-title">Value (% or amount) <span class="tf-color-1">*</span></div>
            <input asp-for="Value" type="number" step="0.01" class="flex-grow" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </fieldset>

        <fieldset class="name">
            <div class="body-title">Currency</div>
            <input asp-for="Currency" class="flex-grow" type="text" />
        </fieldset>

        <fieldset class="name">
            <div class="body-title">Expires At (optional)</div>
            <input asp-for="ExpiresAtUtc" type="date" class="flex-grow" />
        </fieldset>

        <fieldset class="name">
            <div class="body-title">Usage Limit (optional)</div>
            <input asp-for="UsageLimit" type="number" class="flex-grow" />
        </fieldset>

        <fieldset class="name">
            <div class="body-title">Minimum Order Amount (optional)</div>
            <input asp-for="MinimumOrderAmount" type="number" step="0.01" class="flex-grow" />
        </fieldset>

        <div class="bot">
            <a asp-action="Index" class="tf-button style-2 w208">Cancel</a>
            <button class="tf-button w208" type="submit">Create Coupon</button>
        </div>
    </form>
</div>
