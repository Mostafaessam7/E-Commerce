@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@model CreateCouponFormModel
@{
    ViewData["Title"] = "New Coupon";
}

<div class="wg-box" style="max-width:560px">
    <form asp-action="Create" method="post" class="form-style-1">
        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-error"></div>

        <fieldset class="name">
            <div class="body-title">@Localizer["Code"] <span class="tf-color-1">*</span></div>
            <input asp-for="Code" class="flex-grow" type="text" placeholder="e.g. SAVE10" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </fieldset>

        <fieldset class="category">
            <div class="body-title">@Localizer["Discount Type"]</div>
            <div class="select flex-grow">
                <select asp-for="DiscountType">
                    <option value="Percentage">@Localizer["Percentage"]</option>
                    <option value="FixedAmount">@Localizer["Fixed Amount"]</option>
                </select>
            </div>
        </fieldset>

        <fieldset class="name">
            <div class="body-title">@Localizer["Value (% or amount)"] <span class="tf-color-1">*</span></div>
            <input asp-for="Value" type="number" step="0.01" class="flex-grow" />
            <span asp-validation-for="Value" class="text-danger"></span>
        </fieldset>

        <fieldset class="name">
            <div class="body-title">@Localizer["Currency"]</div>
            <input asp-for="Currency" class="flex-grow" type="text" />
        </fieldset>

        <fieldset class="name">
            <div class="body-title">@Localizer["Expires At (optional)"]</div>
            <input asp-for="ExpiresAtUtc" type="date" class="flex-grow" />
        </fieldset>

        <fieldset class="name">
            <div class="body-title">@Localizer["Usage Limit (optional)"]</div>
            <input asp-for="UsageLimit" type="number" class="flex-grow" />
        </fieldset>

        <fieldset class="name">
            <div class="body-title">@Localizer["Minimum Order Amount (optional)"]</div>
            <input asp-for="MinimumOrderAmount" type="number" step="0.01" class="flex-grow" />
        </fieldset>

        <div class="bot">
            <a asp-action="Index" class="tf-button style-2 w208">@Localizer["Cancel"]</a>
            <button class="tf-button w208" type="submit">@Localizer["Create Coupon"]</button>
        </div>
    </form>
</div>
