@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="wg-box mb-30">
    <div class="flex items-center justify-between gap20 flex-wrap">
        <div>
            <h4 class="mb-4">@Localizer["Welcome back"]</h4>
            <div class="body-text">@Localizer["Here's what's happening across the store today."]</div>
        </div>
    </div>
</div>

<div class="flex gap20 flex-wrap mb-30">
    <div class="wg-box flex-grow">
        <div class="flex items-center gap14">
            <div class="dashboard-stat-icon" style="background:var(--Palette-Green-500,#22C55E)">
                <i class="icon-box"></i>
            </div>
            <div>
                <div class="body-text mb-4">@Localizer["Products"]</div>
                <h4>@Model.TotalProducts</h4>
            </div>
        </div>
    </div>
    <div class="wg-box flex-grow">
        <div class="flex items-center gap14">
            <div class="dashboard-stat-icon" style="background:var(--Style,#FF5200)">
                <i class="icon-shopping-bag"></i>
            </div>
            <div>
                <div class="body-text mb-4">@Localizer["Orders"]</div>
                <h4>@Model.TotalOrders</h4>
            </div>
        </div>
    </div>
    <div class="wg-box flex-grow">
        <div class="flex items-center gap14">
            <div class="dashboard-stat-icon" style="background:var(--Palette-Orange-400,#FB923C)">
                <i class="icon-clock"></i>
            </div>
            <div>
                <div class="body-text mb-4">@Localizer["Pending Orders"]</div>
                <h4>@Model.PendingOrders</h4>
            </div>
        </div>
    </div>
    <div class="wg-box flex-grow">
        <div class="flex items-center gap14">
            <div class="dashboard-stat-icon" style="background:#8F77F3">
                <i class="icon-archive"></i>
            </div>
            <div>
                <div class="body-text mb-4">@Localizer["Tracked Stock Items"]</div>
                <h4>@Model.TrackedStockItems</h4>
            </div>
        </div>
    </div>
</div>

<div class="wg-box">
    <h5 class="mb-14">@Localizer["Quick links"]</h5>
    <div class="flex gap10 flex-wrap">
        <a asp-area="Admin" asp-controller="Products" asp-action="Create" class="tf-button style-1 w208"><i class="icon-plus"></i>@Localizer["New Product"]</a>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="tf-button style-2 w208">@Localizer["View Orders"]</a>
        <a asp-area="Admin" asp-controller="Stock" asp-action="Index" class="tf-button style-2 w208">@Localizer["Manage Stock"]</a>
    </div>
</div>
