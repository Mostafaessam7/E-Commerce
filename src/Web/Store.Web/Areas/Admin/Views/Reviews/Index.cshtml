@model IReadOnlyList<ReviewDto>
@{
    ViewData["Title"] = "Reviews";
    var pendingOnly = (bool)ViewBag.PendingOnly;
}

<div class="wg-box">
    <div class="flex items-center justify-between gap10 flex-wrap mb-20">
        <div class="body-text">@Model.Count review(s) shown.</div>
        <div class="flex gap10">
            <a asp-action="Index" asp-route-pendingOnly="true" class="tf-button @(pendingOnly ? "style-1" : "style-2") w150">Pending</a>
            <a asp-action="Index" asp-route-pendingOnly="false" class="tf-button @(!pendingOnly ? "style-1" : "style-2") w150">All</a>
        </div>
    </div>

    <div class="wg-table table-all-category">
        <ul class="table-title flex gap20 mb-14">
            <li><div class="body-title">Reviewer</div></li>
            <li><div class="body-title">Rating</div></li>
            <li><div class="body-title">Body</div></li>
            <li><div class="body-title">Status</div></li>
            <li><div class="body-title">Submitted</div></li>
            <li><div class="body-title">Action</div></li>
        </ul>
        <ul class="flex flex-column">
        @foreach (var review in Model)
        {
            <li class="wg-product item-row gap20">
                <div class="body-text text-main-dark mt-4">@review.ReviewerName</div>
                <div class="body-text text-main-dark mt-4">@review.Rating/5</div>
                <div class="body-text text-main-dark mt-4 line-clamp-2" style="max-width:280px">
                    @if (!string.IsNullOrWhiteSpace(review.Title))
                    {
                        <strong>@review.Title</strong>
                        <text> — </text>
                    }
                    @review.Body
                </div>
                <div class="mt-4"><div class="@StatusBadge.CssClass(review.Status) bg-1 fw-7">@review.Status</div></div>
                <div class="body-text text-main-dark mt-4">@review.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                <div class="list-icon-function">
                    @if (review.Status == "Pending")
                    {
                        <form asp-action="Approve" method="post">
                            <input type="hidden" name="id" value="@review.Id" />
                            <button type="submit" class="item eye" title="Approve"><i class="icon-check"></i></button>
                        </form>
                        <form asp-action="Reject" method="post">
                            <input type="hidden" name="id" value="@review.Id" />
                            <button type="submit" class="item trash" title="Reject"><i class="icon-x"></i></button>
                        </form>
                    }
                </div>
            </li>
        }
        </ul>
    </div>

    @if (Model.Count == 0)
    {
        <p class="mt-14">No reviews to show.</p>
    }
</div>
