@model IReadOnlyList<ReviewDto>
@{
    ViewData["Title"] = "Reviews";
    var pendingOnly = (bool)ViewBag.PendingOnly;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Reviews</h1>
    <div>
        <a asp-action="Index" asp-route-pendingOnly="true" class="btn @(pendingOnly ? "btn-dark" : "btn-secondary") btn-sm">Pending</a>
        <a asp-action="Index" asp-route-pendingOnly="false" class="btn @(!pendingOnly ? "btn-dark" : "btn-secondary") btn-sm">All</a>
    </div>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Reviewer</th>
            <th>Rating</th>
            <th>Title</th>
            <th>Body</th>
            <th>Status</th>
            <th>Submitted</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var review in Model)
    {
        <tr>
            <td>@review.ReviewerName</td>
            <td>@review.Rating/5</td>
            <td>@(review.Title ?? "—")</td>
            <td style="max-width:320px">@review.Body</td>
            <td><span class="admin-badge">@review.Status</span></td>
            <td>@review.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                @if (review.Status == "Pending")
                {
                    <form asp-action="Approve" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@review.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                    </form>
                    <form asp-action="Reject" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@review.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm">Reject</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="mt-3">No reviews to show.</p>
}
