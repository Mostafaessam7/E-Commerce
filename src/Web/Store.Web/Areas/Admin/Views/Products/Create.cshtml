@model ProductFormModel
@{
    ViewData["Title"] = "New Product";
}

<h1>New Product</h1>

<form asp-action="Create" method="post" style="max-width: 560px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" placeholder="e.g. blue-cotton-tshirt" />
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ShortDescription" class="form-label"></label>
        <input asp-for="ShortDescription" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="BrandId" class="form-label"></label>
        <select asp-for="BrandId" class="form-select">
            <option value="">— No brand —</option>
            @foreach (var brand in (IReadOnlyList<BrandDto>)ViewBag.Brands)
            {
                <option value="@brand.Id">@brand.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Categories</label>
        @foreach (var category in (IReadOnlyList<CategoryDto>)ViewBag.Categories)
        {
            <div class="form-check">
                <input type="checkbox" name="CategoryIds" value="@category.Id" class="form-check-input" id="cat-@category.Id" />
                <label class="form-check-label" for="cat-@category.Id">@category.Name</label>
            </div>
        }
        @if (((IReadOnlyList<CategoryDto>)ViewBag.Categories).Count == 0)
        {
            <p class="text-muted">No categories yet.</p>
        }
    </div>

    <button type="submit" class="btn btn-dark">Create Draft</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
