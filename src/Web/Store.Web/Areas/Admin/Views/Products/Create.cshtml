@model ProductFormModel
@{
    ViewData["Title"] = "New Product";
}

<h1>New Product</h1>

<form asp-action="Create" method="post" style="max-width: 560px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" placeholder="e.g. blue-cotton-tshirt" />
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ShortDescription" class="form-label"></label>
        <input asp-for="ShortDescription" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
    </div>

    <button type="submit" class="btn btn-dark">Create Draft</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
