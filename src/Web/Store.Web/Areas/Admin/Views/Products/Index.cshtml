@model ProductSearchResultDto
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a asp-action="Create" class="btn btn-dark">New Product</a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Status</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model.Items)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Slug</td>
            <td><span class="admin-badge">@product.Status</span></td>
            <td>@(product.MinPrice is decimal price ? $"{price:0.00} {product.Currency}" : "—")</td>
            <td><a asp-action="Edit" asp-route-id="@product.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalCount == 0)
{
    <p class="mt-3">No products yet.</p>
}

<nav class="mt-3">
    @{
        var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    }
    @for (var p = 1; p <= totalPages; p++)
    {
        <a asp-action="Index" asp-route-page="@p" class="@(p == Model.Page ? "fw-bold" : "")">@p</a>
        <text> </text>
    }
</nav>
