@model IReadOnlyList<PaymentListItemDto>
@{
    ViewData["Title"] = "Payments";
}

<h1 class="mb-3">Payments</h1>

<table class="admin-table">
    <thead>
        <tr>
            <th>Order</th>
            <th>Provider</th>
            <th>Status</th>
            <th>Amount</th>
            <th>Refunded</th>
            <th>Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var payment in Model)
    {
        var refundable = payment.Status == "Succeeded" && payment.RefundedAmount < payment.Amount;
        <tr>
            <td><a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@payment.OrderId">@payment.OrderId</a></td>
            <td>@payment.Provider</td>
            <td><span class="admin-badge">@payment.Status</span></td>
            <td>@payment.Amount.ToString("0.00") @payment.Currency</td>
            <td>@payment.RefundedAmount.ToString("0.00")</td>
            <td>@payment.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                @if (refundable)
                {
                    <form asp-action="Refund" method="post" class="d-flex gap-1">
                        <input type="hidden" name="PaymentTransactionId" value="@payment.Id" />
                        <input type="number" name="Amount" step="0.01" max="@(payment.Amount - payment.RefundedAmount)"
                               class="form-control form-control-sm" style="width:100px" placeholder="Amount" required />
                        <input type="text" name="Reason" class="form-control form-control-sm" style="width:140px" placeholder="Reason (optional)" />
                        <button type="submit" class="btn btn-secondary btn-sm">Refund</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="mt-3">No payments yet.</p>
}
