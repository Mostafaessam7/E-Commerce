@model IReadOnlyList<BrandDto>
@{
    ViewData["Title"] = "Brands";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Brands</h1>
    <a asp-action="Create" class="btn btn-dark">New Brand</a>
</div>

<table class="admin-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var brand in Model)
    {
        <tr>
            <td>@brand.Name</td>
            <td><code>@brand.Slug</code></td>
            <td><span class="admin-badge">@(brand.IsActive ? "Active" : "Inactive")</span></td>
            <td>
                @if (brand.IsActive)
                {
                    <form asp-action="Deactivate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@brand.Id" />
                        <button type="submit" class="btn btn-secondary btn-sm">Deactivate</button>
                    </form>
                }
                else
                {
                    <form asp-action="Activate" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@brand.Id" />
                        <button type="submit" class="btn btn-success btn-sm">Activate</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p class="mt-3">No brands yet.</p>
}
