@model OrderSearchResultDto
@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<table class="admin-table">
    <thead>
        <tr>
            <th>Order #</th>
            <th>Status</th>
            <th>Payment</th>
            <th>Total</th>
            <th>Placed</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var order in Model.Items)
    {
        <tr>
            <td>@order.OrderNumber</td>
            <td><span class="admin-badge">@order.Status</span></td>
            <td><span class="admin-badge">@order.PaymentStatus</span></td>
            <td>@order.Total.ToString("0.00") @order.Currency</td>
            <td>@order.PlacedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
            <td><a asp-action="Details" asp-route-id="@order.Id">View</a></td>
        </tr>
    }
    </tbody>
</table>

@if (Model.TotalCount == 0)
{
    <p class="mt-3">No orders yet.</p>
}

<nav class="mt-3">
    @{
        var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    }
    @for (var p = 1; p <= totalPages; p++)
    {
        <a asp-action="Index" asp-route-page="@p" class="@(p == Model.Page ? "fw-bold" : "")">@p</a>
        <text> </text>
    }
</nav>
