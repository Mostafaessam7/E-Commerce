@model OrderSearchResultDto
@{
    ViewData["Title"] = "Orders";
}

<div class="wg-box">
    <div class="body-text mb-20">@Model.TotalCount order(s) total.</div>

    <div class="wg-table table-all-category">
        <ul class="table-title flex gap20 mb-14">
            <li><div class="body-title">Order #</div></li>
            <li><div class="body-title">Status</div></li>
            <li><div class="body-title">Payment</div></li>
            <li><div class="body-title">Total</div></li>
            <li><div class="body-title">Placed</div></li>
            <li><div class="body-title">Action</div></li>
        </ul>
        <ul class="flex flex-column">
        @foreach (var order in Model.Items)
        {
            <li class="wg-product item-row gap20">
                <div class="body-text text-main-dark mt-4">@order.OrderNumber</div>
                <div class="mt-4"><div class="@StatusBadge.CssClass(order.Status) bg-1 fw-7">@order.Status</div></div>
                <div class="mt-4"><div class="@StatusBadge.CssClass(order.PaymentStatus) bg-1 fw-7">@order.PaymentStatus</div></div>
                <div class="body-text text-main-dark mt-4">@order.Total.ToString("0.00") @order.Currency</div>
                <div class="body-text text-main-dark mt-4">@order.PlacedAtUtc.ToString("yyyy-MM-dd HH:mm")</div>
                <div class="list-icon-function">
                    <a asp-action="Details" asp-route-id="@order.Id" class="item eye" title="View"><i class="icon-eye"></i></a>
                </div>
            </li>
        }
        </ul>
    </div>

    @if (Model.TotalCount == 0)
    {
        <p class="mt-14">No orders yet.</p>
    }

    @{
        var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
    }
    @if (totalPages > 1)
    {
        <ul class="wg-pagination mt-20">
            @for (var p = 1; p <= totalPages; p++)
            {
                <li class="@(p == Model.Page ? "active" : "")"><a asp-action="Index" asp-route-page="@p">@p</a></li>
            }
        </ul>
    }
</div>
