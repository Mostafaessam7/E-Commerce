@model HomeViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = "Home";
}

@* Category/Brand/Product names come straight from the database (admin-entered catalog content)
   — deliberately never run through Localizer, which is for static UI chrome only. Translating
   catalog content itself would need multi-language fields on the domain model, a separate,
   much larger effort out of scope here. *@
<section class="position-relative">
    <div id="vanta-hero" class="vanta-hero">
        <div class="box-content position-absolute top-50 start-0 translate-middle-y ps-5 text-white" style="max-width:520px;z-index:2">
            <h2 class="display-5 fw-bold">@Localizer["New Season Arrivals"]</h2>
            <p class="mt-3 fs-18">@Localizer["Discover the latest collection, curated for you."]</p>
            <a asp-controller="Shop" asp-action="Index" class="tf-btn btn-fill radius-3 mt-4">@Localizer["Shop now"]<i class="icon icon-arrow1-top-left"></i></a>
        </div>
    </div>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="flat-spacing-1">
        <div class="container">
            <div class="flat-title">
                <span class="section-eyebrow">@Localizer["Browse"]</span>
                <span class="title fs-28 fw-6">@Localizer["Shop by Category"]</span>
            </div>
            <div class="row g-3">
                @foreach (var category in Model.Categories.Where(c => c.IsActive).Take(6))
                {
                    <div class="col-6 col-md-4 col-lg-2">
                        <a class="category-tile" asp-controller="Shop" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="flat-spacing-1" id="featured">
    <div class="container">
        <div class="flat-title">
            <span class="section-eyebrow">@Localizer["Handpicked"]</span>
            <span class="title fs-28 fw-6">@Localizer["Featured Products"]</span>
        </div>

        @if (Model.FeaturedProducts.Count == 0)
        {
            <div class="text-center py-5">
                <p class="text-muted">@Localizer["No featured products yet."]</p>
            </div>
        }
        else
        {
            <div class="tf-grid-layout tf-col-2 md-col-3 xl-col-4">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        }
    </div>
</section>

@if (Model.NewArrivals.Count > 0)
{
    <section class="flat-spacing-1">
        <div class="container">
            <div class="flat-title">
                <span class="section-eyebrow">@Localizer["Just In"]</span>
                <span class="title fs-28 fw-6">@Localizer["New Arrivals"]</span>
            </div>
            <div class="tf-grid-layout tf-col-2 md-col-4">
                @foreach (var product in Model.NewArrivals)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

<section class="flat-spacing-1">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <a asp-controller="Shop" asp-action="Index" class="collection-position position-relative d-block">
                    <img class="lazyload w-100" src="~/ecomus/images/collections/collection-1.jpg" alt="collection" />
                    <div class="content-collection position-absolute bottom-0 start-0 p-4 text-white">
                        <div class="fs-22 fw-6">@Localizer["New Arrivals"]</div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a asp-controller="Shop" asp-action="Index" class="collection-position position-relative d-block">
                    <img class="lazyload w-100" src="~/ecomus/images/collections/collection-2.jpg" alt="collection" />
                    <div class="content-collection position-absolute bottom-0 start-0 p-4 text-white">
                        <div class="fs-22 fw-6">@Localizer["Best Sellers"]</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

@if (Model.Brands.Count > 0)
{
    <section class="flat-spacing-1">
        <div class="container">
            <div class="flat-title">
                <span class="section-eyebrow">@Localizer["Trusted"]</span>
                <span class="title fs-28 fw-6">@Localizer["Shop by Brand"]</span>
            </div>
            <div class="brand-strip">
                @foreach (var brand in Model.Brands.Where(b => b.IsActive))
                {
                    <a class="brand-chip" asp-controller="Shop" asp-action="Index" asp-route-brandId="@brand.Id">@brand.Name</a>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    <script src="~/vendor/vanta/three.min.js"></script>
    <script src="~/vendor/vanta/vanta.net.min.js"></script>
    <script>
        // Phase 30 (ADR-041): animated brand-colored hero background. Guarded behind
        // prefers-reduced-motion and a WebGL capability check — VANTA.NET throws if WebGL isn't
        // available, and a static hero is a perfectly fine fallback rather than a broken page.
        (function () {
            function supportsWebGl() {
                try {
                    var canvas = document.createElement("canvas");
                    return !!(window.WebGLRenderingContext &&
                        (canvas.getContext("webgl") || canvas.getContext("experimental-webgl")));
                } catch (e) {
                    return false;
                }
            }

            var prefersReducedMotion = window.matchMedia &&
                window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            if (prefersReducedMotion || !supportsWebGl() || typeof VANTA === "undefined") {
                document.getElementById("vanta-hero").style.backgroundImage =
                    "url('/ecomus/images/demo/home-01.jpg')";
                document.getElementById("vanta-hero").style.backgroundSize = "cover";
                document.getElementById("vanta-hero").style.backgroundPosition = "center";
                return;
            }

            VANTA.NET({
                el: "#vanta-hero",
                mouseControls: true,
                touchControls: true,
                gyroControls: false,
                minHeight: 200.00,
                minWidth: 200.00,
                scale: 1.00,
                scaleMobile: 1.00,
                color: 0xdb1215,
                backgroundColor: 0x0a0a0a,
                points: 9.00,
                maxDistance: 22.00,
                spacing: 18.00
            });
        })();
    </script>
}
