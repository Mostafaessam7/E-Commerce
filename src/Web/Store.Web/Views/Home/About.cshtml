@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = "Our Story";
}

<section class="flat-spacing-1">
    <div class="container" style="max-width:840px">
        <span class="section-eyebrow">@Localizer["Our Story"]</span>
        <h1 class="fs-28 fw-6 mb-4">@Localizer["About ECommerce"]</h1>

        <p>@Localizer["We started with a simple idea: good, well-made pieces shouldn't be hard to find or complicated to buy. Every product in our catalog is chosen and listed by our small team, and every order — from checkout to delivery — is something we've built and tested ourselves, end to end."]</p>

        <p>@Localizer["We're a young store. We don't have a hundred-year history to tell you about, but we do care about getting the basics right: clear product information, honest pricing, and a checkout that actually works the way it should."]</p>

        <h5 class="mt-20 mb-14">@Localizer["Where we are"]</h5>
        <p>1234 Fashion Street, Suite 567, New York, NY 10001</p>

        <h5 class="mt-20 mb-14">@Localizer["Get in Touch"]</h5>
        <p>@Localizer["Have a question about an order, a product, or anything else? Visit our"]
           <a asp-controller="Home" asp-action="Contact">@Localizer["contact page"]</a> — @Localizer["we read every message."]</p>
    </div>
</section>
