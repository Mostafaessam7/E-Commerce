@model IReadOnlyList<ShippingMethodDto>
@{
    ViewData["Title"] = "Shipping";
}

<section class="flat-spacing-1">
    <div class="container" style="max-width:840px">
        <span class="section-eyebrow">Delivery</span>
        <h1 class="fs-28 fw-6 mb-4">Shipping</h1>
        <p class="text-muted mb-5">Every method below is a real option you can pick at checkout —
            the cost and delivery estimate shown here matches exactly what you'll see there.</p>

        @if (Model.Count == 0)
        {
            <p class="text-muted">No shipping methods are configured right now.</p>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Method</th>
                        <th>Estimated delivery</th>
                        <th>Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var method in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-6">@method.Name</div>
                                @if (!string.IsNullOrWhiteSpace(method.Description))
                                {
                                    <div class="text-muted fs-14">@method.Description</div>
                                }
                            </td>
                            <td>
                                @if (method.EstimatedDaysMin is not null)
                                {
                                    <text>@method.EstimatedDaysMin-@method.EstimatedDaysMax business days</text>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                            <td>@method.Cost.ToString("0.00") @method.Currency</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h5 class="mt-20 mb-14">Order tracking</h5>
        <p>Once your order ships, its status updates on your
           <a asp-controller="Profile" asp-action="Orders">My Orders</a> page.</p>
    </div>
</section>
