@model ProductSummaryDto
@* Section 3's reusable "Product Card" component. Adapted from ecomus-package/ecomus/shop-default.html's
   .card-product markup — quick-add/wishlist/compare/quick-view actions dropped for now since they
   need Cart/Wishlist (Phase 7+), which don't exist yet; the visual card (image, title, price) is
   otherwise the same structure/classes as the template. *@
<div class="card-product">
    <div class="card-product-wrapper">
        <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug" class="product-img">
            <img class="lazyload img-product"
                 src="@(Model.PrimaryImageUrl ?? "/ecomus/images/products/white-1.jpg")"
                 alt="@Model.Name">
        </a>
    </div>
    <div class="card-product-info">
        <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug" class="title link">@Model.Name</a>
        @if (Model.MinSalePrice is decimal sale)
        {
            <span class="price">
                <span class="new-price">@sale.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                <span class="old-price text-decoration-line-through text-muted ms-2">@Model.MinPrice?.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
            </span>
        }
        else
        {
            <span class="price">@(Model.MinPrice?.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")) ?? "-")</span>
        }
    </div>
</div>
