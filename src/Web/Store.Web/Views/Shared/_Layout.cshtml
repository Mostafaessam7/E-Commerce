@{
    // Phase 41 (ADR-052): CurrentUICulture is set by UseRequestLocalization (Program.cs) from the
    // standard culture cookie/query-string/Accept-Language before this view ever runs.
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture;
    // Not currentCulture.TextInfo.IsRightToLeft: the neutral "ar" CultureInfo (as opposed to a
    // specific one like "ar-EG") doesn't reliably report IsRightToLeft=true across .NET/ICU
    // versions — confirmed live (lang="ar" rendered correctly, dir stayed "ltr"). Since this app
    // only ever supports exactly "en"/"ar" (Program.cs), a direct language-code check is both
    // simpler and actually correct.
    var isRtl = currentCulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@currentCulture.TwoLetterISOLanguageName" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    @* Phase 40 (ADR-051): set the theme attribute before first paint so there's no light-mode
       flash on a dark-mode visit. Deliberately inline/blocking, not deferred to main.js — the
       whole point is this runs before the browser paints anything. *@
    <script nonce="@Context.CspNonce()">
        (function () {
            var stored = localStorage.getItem("theme");
            var theme = stored || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.setAttribute("data-theme", theme);
        })();
    </script>
    <title>@(ViewData["Title"] is not null ? $"{ViewData["Title"]} - ECommerce" : "ECommerce")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <meta name="description" content="@(ViewData["Description"] ?? "Shop the latest products at ECommerce.")" />

    <link rel="stylesheet" href="~/ecomus/fonts/fonts.css" />
    <link rel="stylesheet" href="~/ecomus/fonts/font-icons.css" />
    <link rel="stylesheet" href="~/ecomus/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/ecomus/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/ecomus/css/animate.css" />
    <link rel="stylesheet" href="~/ecomus/css/styles.css" />
    <link rel="stylesheet" href="~/css/site-custom.css" />
    @* Shared Mecodex tokens load first: design-system.css's own --ds-* tokens now
       alias onto --mx-*, so those have to be defined before it. E-Commerce is
       assigned Amber Commerce. *@
    <link rel="stylesheet" href="~/design-system/tokens.css" />
    <link rel="stylesheet" href="~/design-system/themes/amber-commerce.css" />
    <link rel="stylesheet" href="~/css/design-system.css" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" />
    }

    <link rel="shortcut icon" href="~/ecomus/images/logo/favicon.png" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="preload-wrapper">
    <div id="wrapper">
        <partial name="_Header" />

        <main>
            @RenderBody()
        </main>

        <partial name="_Footer" />
    </div>

    <partial name="_MobileMenu" />

    <script src="~/ecomus/js/bootstrap.min.js"></script>
    <script src="~/ecomus/js/jquery.min.js"></script>
    <script src="~/ecomus/js/swiper-bundle.min.js"></script>
    <script src="~/ecomus/js/carousel.js"></script>
    <script src="~/ecomus/js/bootstrap-select.min.js"></script>
    <script src="~/ecomus/js/lazysize.min.js"></script>
    <script src="~/ecomus/js/wow.min.js"></script>
    <script src="~/ecomus/js/main.js"></script>
    <script nonce="@Context.CspNonce()">
        (function () {
            var toggle = document.getElementById("themeToggle");
            if (!toggle) {
                return;
            }
            toggle.addEventListener("click", function () {
                var current = document.documentElement.getAttribute("data-theme");
                var next = current === "dark" ? "light" : "dark";
                document.documentElement.setAttribute("data-theme", next);
                localStorage.setItem("theme", next);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
