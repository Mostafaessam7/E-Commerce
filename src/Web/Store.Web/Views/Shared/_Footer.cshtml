@* Adapted from ecomus-package/ecomus/index.html's <footer> almost verbatim — this section had no
   template-demo-showcase content to strip, just relative asset paths rewritten to ~/ecomus/... *@
<footer id="footer" class="footer md-pb-70">
    <div class="footer-wrap">
        <div class="footer-body">
            <div class="container">
                <div class="row">
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="footer-infor">
                            <div class="footer-logo">
                                <a asp-controller="Home" asp-action="Index">
                                    <img src="~/ecomus/images/logo/logo.svg" alt="">
                                </a>
                            </div>
                            <ul>
                                <li><p>Address: 1234 Fashion Street, Suite 567, <br> New York, NY 10001</p></li>
                                <li><p>Email: <a href="mailto:info@ecommerce.local">info@ecommerce.local</a></p></li>
                                <li><p>Phone: <a href="tel:+12125551234">(212) 555-1234</a></p></li>
                            </ul>
                            <ul class="tf-social-icon d-flex gap-10">
                                <li><a href="#" class="box-icon w_34 round social-facebook social-line"><i class="icon fs-14 icon-fb"></i></a></li>
                                <li><a href="#" class="box-icon w_34 round social-twiter social-line"><i class="icon fs-12 icon-Icon-x"></i></a></li>
                                <li><a href="#" class="box-icon w_34 round social-instagram social-line"><i class="icon fs-14 icon-instagram"></i></a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12 footer-col-block">
                        <div class="footer-heading footer-heading-desktop"><h6>Help</h6></div>
                        <ul class="footer-menu-list tf-collapse-content">
                            <li><a asp-controller="Home" asp-action="Privacy" class="footer-menu_item">Privacy Policy</a></li>
                            <li><a asp-controller="Home" asp-action="Returns" class="footer-menu_item">Returns + Exchanges</a></li>
                            <li><a asp-controller="Home" asp-action="Shipping" class="footer-menu_item">Shipping</a></li>
                            <li><a asp-controller="Home" asp-action="Terms" class="footer-menu_item">Terms &amp; Conditions</a></li>
                            <li><a asp-controller="Home" asp-action="Faq" class="footer-menu_item">FAQ's</a></li>
                        </ul>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12 footer-col-block">
                        <div class="footer-heading footer-heading-desktop"><h6>About us</h6></div>
                        <ul class="footer-menu-list tf-collapse-content">
                            <li><a asp-controller="Home" asp-action="About" class="footer-menu_item">Our Story</a></li>
                            <li><a asp-controller="Home" asp-action="About" class="footer-menu_item">Visit Our Store</a></li>
                            <li><a asp-controller="Home" asp-action="Contact" class="footer-menu_item">Contact Us</a></li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li><a asp-controller="Profile" asp-action="Index" class="footer-menu_item">Account</a></li>
                            }
                            else
                            {
                                <li><a asp-controller="Account" asp-action="Login" class="footer-menu_item">Account</a></li>
                            }
                        </ul>
                    </div>
                    <div class="col-xl-3 col-md-6 col-12">
                        <div class="footer-newsletter footer-col-block">
                            <div class="footer-heading footer-heading-desktop"><h6>Sign Up for Email</h6></div>
                            <div class="tf-collapse-content">
                                <div class="footer-menu_item">Get first dibs on new arrivals, sales and more.</div>
                                <form class="form-newsletter subscribe-form" action="#" method="post">
                                    <div class="subscribe-content">
                                        <fieldset class="email">
                                            <input type="email" name="email-form" class="subscribe-email" placeholder="Enter your email....">
                                        </fieldset>
                                        <div class="button-submit">
                                            <button class="subscribe-button tf-btn btn-sm radius-3 btn-fill btn-icon animate-hover-btn" type="button">Subscribe<i class="icon icon-arrow1-top-left"></i></button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="footer-bottom-wrap d-flex gap-20 flex-wrap justify-content-between align-items-center">
                            <div class="footer-menu_item">&copy; @DateTime.UtcNow.Year ECommerce. All Rights Reserved</div>
                            <div class="tf-payment">
                                <img src="~/ecomus/images/payments/visa.png" alt="">
                                <img src="~/ecomus/images/payments/img-1.png" alt="">
                                <img src="~/ecomus/images/payments/img-2.png" alt="">
                                <img src="~/ecomus/images/payments/img-3.png" alt="">
                                <img src="~/ecomus/images/payments/img-4.png" alt="">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
