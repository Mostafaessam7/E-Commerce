@* Ecomus template header, adapted: the source template's "Home" nav item is a mega-menu
   showcasing ~30 demo homepage variants (irrelevant to a real store) — replaced with real site
   navigation using the same CSS classes (header-default, box-navigation, nav-icon, ...) so
   wwwroot/ecomus/css/styles.css still styles it correctly. See docs/current-state.md Phase 5. *@
@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    var otherCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "en" : "ar";
    var otherCultureLabel = otherCulture == "ar" ? "العربية" : "English";
}
<header id="header" class="header-default header-absolute">
    <div class="px_15 lg-px_40">
        <div class="row wrapper-header align-items-center">
            <div class="col-md-4 col-3 tf-lg-hidden">
                <a href="#mobileMenu" data-bs-toggle="offcanvas" aria-controls="mobileMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="16" viewBox="0 0 24 16" fill="none">
                        <path d="M2.00056 2.28571H16.8577C17.1608 2.28571 17.4515 2.16531 17.6658 1.95098C17.8802 1.73665 18.0006 1.44596 18.0006 1.14286C18.0006 0.839753 17.8802 0.549063 17.6658 0.334735C17.4515 0.120408 17.1608 0 16.8577 0H2.00056C1.69745 0 1.40676 0.120408 1.19244 0.334735C0.978109 0.549063 0.857702 0.839753 0.857702 1.14286C0.857702 1.44596 0.978109 1.73665 1.19244 1.95098C1.40676 2.16531 1.69745 2.28571 2.00056 2.28571ZM0.857702 8C0.857702 7.6969 0.978109 7.40621 1.19244 7.19188C1.40676 6.97755 1.69745 6.85714 2.00056 6.85714H22.572C22.8751 6.85714 23.1658 6.97755 23.3801 7.19188C23.5944 7.40621 23.7148 7.6969 23.7148 8C23.7148 8.30311 23.5944 8.59379 23.3801 8.80812C23.1658 9.02245 22.8751 9.14286 22.572 9.14286H2.00056C1.69745 9.14286 1.40676 9.02245 1.19244 8.80812C0.978109 8.59379 0.857702 8.30311 0.857702 8ZM0.857702 14.8571C0.857702 14.554 0.978109 14.2633 1.19244 14.049C1.40676 13.8347 1.69745 13.7143 2.00056 13.7143H12.2863C12.5894 13.7143 12.8801 13.8347 13.0944 14.049C13.3087 14.2633 13.4291 14.554 13.4291 14.8571C13.4291 15.1602 13.3087 15.4509 13.0944 15.6653C12.8801 15.8796 12.5894 16 12.2863 16H2.00056C1.69745 16 1.40676 15.8796 1.19244 15.6653C0.978109 15.4509 0.857702 15.1602 0.857702 14.8571Z" fill="currentColor"></path>
                    </svg>
                </a>
            </div>
            <div class="col-xl-3 col-md-4 col-6">
                <a asp-controller="Home" asp-action="Index" class="logo-header">
                    <img src="~/ecomus/images/logo/logo.svg" alt="logo" class="logo">
                </a>
            </div>
            <div class="col-xl-6 tf-md-hidden">
                <nav class="box-navigation text-center">
                    <ul class="box-nav-ul d-flex align-items-center justify-content-center gap-30">
                        <li class="menu-item"><a asp-controller="Home" asp-action="Index" class="item-link">@Localizer["Home"]</a></li>
                        <li class="menu-item"><a asp-controller="Shop" asp-action="Index" class="item-link">@Localizer["Shop"]</a></li>
                        <li class="menu-item"><a asp-controller="Home" asp-action="Index" asp-fragment="featured" class="item-link">@Localizer["Featured"]</a></li>
                        <li class="menu-item"><a asp-controller="Home" asp-action="About" class="item-link">@Localizer["About"]</a></li>
                        <li class="menu-item"><a asp-controller="Home" asp-action="Contact" class="item-link">@Localizer["Contact"]</a></li>
                    </ul>
                </nav>
            </div>
            <div class="col-xl-3 col-md-4 col-3">
                <ul class="nav-icon d-flex justify-content-end align-items-center gap-20">
                    <li>
                        <form asp-controller="Language" asp-action="SetLanguage" method="post">
                            <input type="hidden" name="culture" value="@otherCulture" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="theme-toggle" style="width:auto;padding:0 10px;font-size:12px;font-weight:600" title="@otherCultureLabel">@otherCultureLabel</button>
                        </form>
                    </li>
                    <li>
                        <button type="button" class="theme-toggle" id="themeToggle" aria-label="@Localizer["Toggle dark mode"]" title="@Localizer["Toggle dark mode"]">
                            <svg class="icon-sun-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <circle cx="12" cy="12" r="4"></circle>
                                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
                            </svg>
                            <svg class="icon-moon-svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 1020.354 15.354z"></path>
                            </svg>
                        </button>
                    </li>
                    <li class="nav-search">
                        <a asp-controller="Shop" asp-action="Index" class="nav-icon-item"><i class="icon icon-search"></i></a>
                    </li>
                    <li class="nav-account">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Profile" asp-action="Index" class="nav-icon-item"><i class="icon icon-account"></i></a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="nav-icon-item"><i class="icon icon-account"></i></a>
                        }
                    </li>
                    @* Wishlist icon deliberately dropped, not just hidden — it isn't one of the
                       fixed 10 modules (AGENTS.md) and a "#" link with a hardcoded "0" count
                       would be dead UI pretending to work. Add it back for real if a Wishlist
                       module is ever built. *@
                    <li class="nav-cart"><a asp-controller="Cart" asp-action="Index" class="nav-icon-item"><i class="icon icon-bag"></i><span class="count-box">0</span></a></li>
                </ul>
            </div>
        </div>
    </div>
</header>
