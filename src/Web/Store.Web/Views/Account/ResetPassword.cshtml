@model Store.Web.Models.ResetPasswordViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-split">
    <div class="auth-form-panel">
        <div class="auth-form-inner">
            <h2 class="mb-2">@Localizer["Reset Password"]</h2>
            <p class="text-muted mb-4">@Localizer["Choose a new password for your account."]</p>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">@Localizer["New Password"]</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">@Localizer["Confirm Password"]</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="tf-btn btn-fill radius-3 w-100 justify-content-center">@Localizer["Reset Password"]<i class="icon icon-arrow1-top-left"></i></button>
            </form>
        </div>
    </div>

    <div id="vanta-auth" class="auth-visual">
        <div class="auth-visual-copy">
            <div class="fs-28 fw-6">@Localizer["Almost there"]</div>
            <p class="mt-2 mb-0">@Localizer["Pick something you'll remember — and sign back in."]</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_VantaAuthScript" />
}
