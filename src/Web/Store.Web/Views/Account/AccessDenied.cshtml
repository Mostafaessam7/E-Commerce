@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center" style="padding: 80px 0;">
    <h2>@Localizer["Access Denied"]</h2>
    <p>@Localizer["You don't have permission to view this page."]</p>
    <a href="/" class="btn btn-dark">@Localizer["Back to Home"]</a>
</div>
