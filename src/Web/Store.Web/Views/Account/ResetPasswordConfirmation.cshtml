@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = "Password Reset";
}

<div class="container text-center" style="max-width: 480px; padding: 80px 0;">
    <h2>@Localizer["Password Reset"]</h2>
    <p>@Localizer["Your password has been reset. You can sign in with your new password now."]</p>
    <a asp-action="Login" class="btn btn-dark">@Localizer["Sign In"]</a>
</div>
