@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container text-center" style="max-width: 480px; padding: 80px 0;">
    <h2>@Localizer["Check Your Email"]</h2>
    <p>@Localizer["If an account exists for that email, we've sent a password reset link to it."]</p>
    <a asp-action="Login" class="btn btn-dark">@Localizer["Back to Sign In"]</a>
</div>
