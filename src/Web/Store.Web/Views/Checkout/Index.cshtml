@model CheckoutFormModel
@{
    ViewData["Title"] = "Checkout";
}

<section class="flat-spacing">
    <div class="container" style="max-width:720px">
        <h1 class="fs-28 fw-6 mb-4">Checkout</h1>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form method="post" asp-controller="Checkout" asp-action="PlaceOrder">
            <h5 class="mb-3">Shipping address</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Line1" class="form-label"></label>
                    <input asp-for="Line1" class="form-control" />
                    <span asp-validation-for="Line1" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Line2" class="form-label"></label>
                    <input asp-for="Line2" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="State" class="form-label"></label>
                    <input asp-for="State" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="PostalCode" class="form-label"></label>
                    <input asp-for="PostalCode" class="form-control" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Country" class="form-label"></label>
                    <input asp-for="Country" class="form-control" maxlength="2" placeholder="EG" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check mb-4">
                <input asp-for="BillingSameAsShipping" class="form-check-input" />
                <label asp-for="BillingSameAsShipping" class="form-check-label">Billing address same as shipping</label>
            </div>

            <div class="mb-4">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>

            <button type="submit" class="tf-btn btn-fill radius-3">Place order<i class="icon icon-arrow1-top-left"></i></button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
