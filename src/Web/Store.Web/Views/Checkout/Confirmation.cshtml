@model OrderDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = "Order Confirmed";
}

<section class="flat-spacing-1">
    <div class="container" style="max-width:720px">
        <div class="text-center mb-5">
            <h1 class="fs-28 fw-6">@Localizer["Thank you — order placed!"]</h1>
            <p class="text-muted">@Localizer["Order number"]: <strong>@Model.OrderNumber</strong></p>
        </div>

        <table class="table">
            <thead>
                <tr><th>@Localizer["Product"]</th><th>@Localizer["Qty"]</th><th>@Localizer["Total"]</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName <span class="text-muted fs-14">(@item.Sku)</span></td>
                        <td>@item.Quantity</td>
                        <td>@item.LineTotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end">
            <div>@Localizer["Subtotal"]: @Model.Subtotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</div>
            <div>@Localizer["Shipping"]: @Model.ShippingCost.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</div>
            <div>@Localizer["Tax"]: @Model.Tax.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</div>
            <div class="fs-20 fw-6 mt-2">@Localizer["Total"]: @Model.Total.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</div>
        </div>

        <div class="mt-4">
            <span class="badge @OrderStatusBadge.CssClass(Model.Status)">@Localizer["Status"]: @Localizer[Model.Status]</span>
            <span class="badge @OrderStatusBadge.CssClass(Model.PaymentStatus)">@Localizer["Payment"]: @Localizer[Model.PaymentStatus]</span>
        </div>

        @if (TempData["PaymentError"] is string paymentError)
        {
            <div class="alert alert-danger mt-3">@paymentError</div>
        }

        @if (Model.PaymentStatus == "Pending")
        {
            <form method="post" asp-controller="Payments" asp-action="Pay" class="mt-4 text-center">
                <input type="hidden" name="orderId" value="@Model.Id" />
                @* No real payment provider is wired up — this drives the real webhook endpoint
                   with a self-signed simulated payload rather than skipping it (see
                   PaymentsController's doc comment / docs/decisions.md ADR on Payments). *@
                <button type="submit" class="tf-btn btn-fill radius-3">@Localizer["Pay now (simulated)"]<i class="icon icon-arrow1-top-left"></i></button>
            </form>
        }
    </div>
</section>
