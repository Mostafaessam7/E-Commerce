@model ProductDetailsDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<Store.Web.SharedResource> Localizer
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Name;
    ViewData["Description"] = Model.MetaDescription ?? Model.ShortDescription;
    var primaryImage = Model.Images.FirstOrDefault(i => i.IsPrimary) ?? Model.Images.FirstOrDefault();
    var cheapestVariant = Model.Variants.OrderBy(v => v.SalePrice ?? v.Price).FirstOrDefault();
}

<section class="flat-spacing-1">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="tf-product-media-main">
                    <img class="lazyload w-100" src="@(primaryImage?.Url ?? "/ecomus/images/products/white-1.jpg")" alt="@Model.Name" />
                </div>
                @if (Model.Images.Count > 1)
                {
                    <div class="d-flex gap-2 mt-3">
                        @foreach (var image in Model.Images)
                        {
                            <img class="lazyload" style="width:80px;height:80px;object-fit:cover" src="@image.Url" alt="@image.AltText" />
                        }
                    </div>
                }
            </div>

            <div class="col-lg-6">
                <div class="tf-product-info-wrap">
                    <h1 class="fs-28 fw-6">@Model.Name</h1>

                    @if (cheapestVariant is not null)
                    {
                        <div class="price mt-2 fs-22">
                            @if (cheapestVariant.SalePrice is decimal sale)
                            {
                                <span class="new-price fw-6">@sale.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                                <span class="old-price text-decoration-line-through text-muted ms-2">@cheapestVariant.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                            }
                            else
                            {
                                <span class="fw-6">@cheapestVariant.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                    {
                        <p class="mt-3 text-muted">@Model.ShortDescription</p>
                    }

                    @if (cheapestVariant is not null)
                    {
                        <form method="post" asp-controller="Cart" asp-action="Add" class="mt-4">
                            @if (Model.Variants.Count > 1)
                            {
                                <label class="form-label fw-6">@Localizer["Variant"]</label>
                                <select name="productVariantId" class="form-select mb-3" style="max-width:320px">
                                    @foreach (var variant in Model.Variants)
                                    {
                                        <option value="@variant.Id">@variant.Sku — @variant.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="hidden" name="productVariantId" value="@cheapestVariant.Id" />
                            }
                            <div class="d-flex align-items-center gap-3">
                                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:90px" />
                                <button type="submit" class="tf-btn btn-fill radius-3">@Localizer["Add to cart"]<i class="icon icon-bag"></i></button>
                            </div>
                        </form>
                    }

                    @if (Model.Tags.Count > 0)
                    {
                        <div class="mt-4 d-flex gap-2 flex-wrap">
                            @foreach (var tag in Model.Tags)
                            {
                                <span class="badge bg-light text-dark border">@tag</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="row mt-5">
                <div class="col-12">
                    <h5>@Localizer["Description"]</h5>
                    @* Plain-text encoded output, not Html.Raw: descriptions aren't sanitized rich
                       text yet. Revisit with an HTML sanitizer (e.g. HtmlSanitizer) if/when the
                       admin panel starts accepting formatted HTML for this field. *@
                    <div class="mt-2">@Model.Description</div>
                </div>
            </div>
        }

        @{
            var reviews = (ProductReviewsDto)ViewBag.Reviews;
            var reviewForm = (SubmitReviewFormModel)ViewBag.ReviewForm;
        }
        <div class="row mt-5">
            <div class="col-lg-6">
                <h5>
                    @Localizer["Reviews"]
                    @if (reviews.AverageRating is double avg)
                    {
                        <span class="text-muted fs-16">— @avg.ToString("0.0")/5 (@reviews.ApprovedCount)</span>
                    }
                </h5>

                @* Bug fix (Phase 31): these used to render `admin-alert admin-alert-*`, a class
                   only defined in wwwroot/admin/admin-overrides.css (Admin-area-only stylesheet,
                   never loaded on the storefront) — completely unstyled raw text on this page.
                   Bootstrap's own `alert` is already loaded here and used the same way on
                   /Profile. *@
                @if (TempData["ReviewSuccess"] is string success)
                {
                    <div class="alert alert-success mt-2">@success</div>
                }
                @if (TempData["ReviewError"] is string error)
                {
                    <div class="alert alert-danger mt-2">@error</div>
                }

                @if (reviews.Reviews.Count == 0)
                {
                    <p class="mt-3 text-muted">@Localizer["No reviews yet — be the first."]</p>
                }
                else
                {
                    <div class="mt-3">
                        @foreach (var review in reviews.Reviews)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="fw-6">@review.ReviewerName — @review.Rating/5</div>
                                @if (!string.IsNullOrWhiteSpace(review.Title))
                                {
                                    <div class="fw-6 mt-1">@review.Title</div>
                                }
                                <p class="mt-1 mb-0">@review.Body</p>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="col-lg-6">
                <h5>@Localizer["Write a review"]</h5>
                <form method="post" asp-controller="Product" asp-action="SubmitReview" asp-route-slug="@Model.Slug" class="mt-3">
                    <input type="hidden" name="ProductId" value="@reviewForm.ProductId" />
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Name"]</label>
                        <input name="ReviewerName" class="form-control" required maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Email (optional)"]</label>
                        <input name="ReviewerEmail" type="email" class="form-control" maxlength="256" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Rating"]</label>
                        <select name="Rating" class="form-select" style="max-width:160px" required>
                            <option value="">@Localizer["Choose..."]</option>
                            <option value="5">5 — @Localizer["Excellent"]</option>
                            <option value="4">4 — @Localizer["Good"]</option>
                            <option value="3">3 — @Localizer["Average"]</option>
                            <option value="2">2 — @Localizer["Poor"]</option>
                            <option value="1">1 — @Localizer["Terrible"]</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Title (optional)"]</label>
                        <input name="Title" class="form-control" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Localizer["Review"]</label>
                        <textarea name="Body" class="form-control" rows="4" required maxlength="4000"></textarea>
                    </div>
                    <button type="submit" class="tf-btn btn-fill radius-3">@Localizer["Submit review"]</button>
                </form>
            </div>
        </div>
    </div>
</section>
